{
  "name": "bot",
  "version": "0.1.0",
  "description": "Lightweight and extensible WhatsApp bot powered by Zapo-js.",
  "main": "src/bot.js",
  "type": "module",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "node --watch src/bot.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-bot",
    "bot",
    "zapo-js",
    "zapo",
    "automation",
    "nodejs"
  ],
  "author": {
    "name": "fodnz",
    "url": "https://github.com/fodnz"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fodnz/bot.git"
  },
  "bugs": {
    "url": "https://github.com/fodnz/bot/issues"
  },
  "homepage": "https://github.com/fodnz/bot#readme",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@zapo-js/media-utils": "^1.0.0",
    "@zapo-js/native": "^0.1.0",
    "@zapo-js/store-sqlite": "^1.2.0",
    "better-sqlite3": "^13.0.3",
    "zapo-js": "^1.8.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "zapo-js@1.8.2": true
  }
}
